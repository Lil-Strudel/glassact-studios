# Vite inlines VITE_* vars into the client bundle, so this key is public by
# design and is committed deliberately — the CI build has no other way to see
# it (.env is gitignored). What protects it is the restriction config in Google
# Cloud, not secrecy: it must stay locked to the prod HTTP referrer and to the
# Maps JavaScript + Places APIs.
VITE_GOOGLE_MAPS_API_KEY=AIzaSyAcc0iqLRnyZ0aimV3CUTqB_vDb9vGA6xs
