---
import { Image } from "astro:assets";
import Layout from "../layouts/layout.astro";
import PageHeader from "../components/page-header.astro";
import ArrowIcon from "../components/arrow-icon.astro";
import EmailIcon from "../components/email-svg.astro";
import PhoneIcon from "../components/phone-svg.astro";
import AddressIcon from "../components/address-svg.astro";
import TroutImg from "../assets/images/gallery/Troud_d600.jpg";
import { contactDetails, customerPortalUrl } from "../data/site";

const contactMethods = [
  {
    icon: EmailIcon,
    label: "Email",
    href: `mailto:${contactDetails.email}`,
    lines: [contactDetails.email],
  },
  {
    icon: PhoneIcon,
    label: "Phone",
    href: contactDetails.phoneHref,
    lines: [contactDetails.phoneDisplay],
  },
  {
    icon: AddressIcon,
    label: "Studio",
    href: contactDetails.mapsHref,
    lines: [contactDetails.companyName, contactDetails.streetAddress, contactDetails.locality],
  },
];
---

<Layout title="Contact">
  <PageHeader
    eyebrow="Contact"
    title="Get in touch."
    lede="Questions about ordering, pricing or a custom design? Reach us by email or phone below. We aim to reply within 24 hours."
  />

  <section class="py-14 sm:py-20">
    <div class="shell grid items-start gap-14 lg:grid-cols-[minmax(0,7fr)_minmax(0,5fr)] lg:gap-20">
      <div class="grid gap-4">
        <ul class="grid gap-4">
          {
            contactMethods.map((method) => (
              <li>
                <a
                  href={method.href}
                  class="group flex items-start gap-5 rounded-lg border border-border bg-card p-5 transition-colors hover:border-gilt/45 sm:p-6"
                >
                  <span class="flex size-12 shrink-0 items-center justify-center rounded-md bg-crimson-deep/60 text-gilt">
                    <method.icon />
                  </span>
                  <span class="grid gap-1">
                    <span class="eyebrow">{method.label}</span>
                    {method.lines.map((line, index) => (
                      <span class:list={[index === 0 ? "font-display text-xl text-foreground group-hover:text-gilt sm:text-2xl" : "text-muted-foreground", "tabular-nums break-words"]}>
                        {line}
                      </span>
                    ))}
                  </span>
                </a>
              </li>
            ))
          }
        </ul>

        <div class="mt-4 flex flex-col gap-3 rounded-lg border border-dashed border-input p-5 sm:flex-row sm:items-center sm:justify-between sm:p-6">
          <div>
            <p class="font-display text-lg">Already ordering with us?</p>
            <p class="text-sm text-muted-foreground">
              Track projects, approve proofs and place orders in the customer portal.
            </p>
          </div>
          <a
            href={customerPortalUrl}
            class="inline-flex shrink-0 items-center gap-2 text-crimson-light underline-offset-4 hover:underline"
          >
            Customer portal
            <ArrowIcon direction="up-right" />
          </a>
        </div>
      </div>

      <figure class="mx-auto w-full max-w-sm lg:max-w-none">
        <div class="arched-frame aspect-[4/5] bg-came">
          <Image
            src={TroutImg}
            alt="A rainbow trout glass inlay leaping from a splash of water, set in grey granite"
            widths={[400, 600]}
            sizes="(min-width: 1024px) 34vw, 90vw"
            class="size-full object-cover"
          />
        </div>
      </figure>
    </div>
  </section>
</Layout>
