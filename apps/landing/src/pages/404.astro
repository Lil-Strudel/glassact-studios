---
import Layout from "../layouts/layout.astro";
import ButtonLink from "../components/button-link.astro";
import OrnamentRule from "../components/ornament-rule.astro";
---

<Layout title="Page not found">
  <section class="crimson-wash flex grow items-center py-16 sm:py-24">
    <div class="shell grid justify-items-center gap-6 text-center">
      <p class="eyebrow text-gilt">Error 404</p>
      <h1 class="text-4xl sm:text-5xl">Page not found</h1>
      <OrnamentRule class="w-56" />
      <p class="max-w-md text-lg text-muted-foreground">
        Sorry, the page you’re looking for doesn’t exist.
      </p>
      <div class="mt-2 flex flex-wrap justify-center gap-3">
        <ButtonLink href="/">Back to home</ButtonLink>
        <ButtonLink href="/gallery" variant="secondary">View the gallery</ButtonLink>
      </div>
    </div>
  </section>
</Layout>
