---
import { Image, getImage } from "astro:assets";
import Layout from "../layouts/layout.astro";
import { GalleryLightbox } from "../components/gallery-lightbox";

// Sorted by filename so the on-page order is stable across builds.
const modules = import.meta.glob<{ default: ImageMetadata }>(
  "../assets/images/gallery/*.{jpg,jpeg,png}",
  { eager: true },
);

const images = Object.keys(modules)
  .sort()
  .map((path) => modules[path].default);

// A larger variant per image for the full-screen viewer. The grid keeps its own
// small, lazy thumbnails so the page still paints without waiting on these.
const fullImages = await Promise.all(
  images.map((image) => getImage({ src: image, width: 1600, format: "webp" })),
);

const lightboxImages = fullImages.map((full, index) => ({
  src: full.src,
  alt: `Stained glass inlay ${index + 1}`,
}));
---
<Layout>
  <section class="grow">
    <div class="max-w-screen-xl px-4 md:px-8 py-24 mx-auto flex flex-wrap">
      <div class="flex w-full mb-20 flex-wrap">
        <h1
          class="sm:text-3xl text-2xl font-medium title-font text-gray-900 lg:w-1/3 lg:mb-0 mb-4"
        >
          Gallery
        </h1>
        <p class="lg:pl-6 lg:w-2/3 mx-auto leading-relaxed text-base">
          We custom fuse a ¼ inch thick, multi-layered, glass ingot. This glass
          piece gets cut, shaped, fire polished, and annealed to ensure a
          perfect fit and finish. The finished result is an inlay that is up to
          200 times harder than regular glass. The glass gets installed flush
          with the granite surface and then finished with a cement based grout.
          The finished product is as strong as sandblasted granite itself.{" "}
          <span class="font-bold">
            We sell a method of permanent color, not a particular style. We work
            hard to produce any type of design and strive to maintain the
            essence of the original artwork.
          </span>
        </p>
      </div>
      <div class="max-w-screen-xl w-full">
        <div
          id="gallery-grid"
          class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4"
        >
          {
            images.map((image, index) => (
              <button
                type="button"
                data-gallery-index={index}
                aria-label={`View stained glass inlay ${index + 1} full screen`}
                class="overflow-hidden h-[300px] flex items-center cursor-zoom-in focus:outline-none focus-visible:ring-2 focus-visible:ring-offset-2 focus-visible:ring-gray-900"
              >
                <Image
                  src={image}
                  alt={`Stained glass inlay ${index + 1}`}
                  widths={[400, 800]}
                  sizes="(min-width: 1024px) 33vw, (min-width: 640px) 50vw, 100vw"
                  loading="lazy"
                  class="w-full h-full object-cover"
                />
              </button>
            ))
          }
        </div>
      </div>

      <GalleryLightbox
        client:idle
        images={lightboxImages}
        gridId="gallery-grid"
      />
    </div>
  </section>
</Layout>
