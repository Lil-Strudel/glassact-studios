---
import { Image, getImage } from "astro:assets";
import Layout from "../layouts/layout.astro";
import PageHeader from "../components/page-header.astro";
import ClosingInvitation from "../components/closing-invitation.astro";
import { GalleryLightbox } from "../components/gallery-lightbox";

const modules = import.meta.glob<{ default: ImageMetadata }>(
  "../assets/images/gallery/*.{jpg,jpeg,png}",
  { eager: true },
);

const images = Object.keys(modules)
  .sort()
  .map((path) => modules[path].default);

const fullImages = await Promise.all(
  images.map((image) => getImage({ src: image, width: 1600, format: "webp" })),
);

const lightboxImages = fullImages.map((full, index) => ({
  src: full.src,
  alt: `Stained glass inlay ${index + 1}`,
}));
---

<Layout title="Gallery">
  <PageHeader
    eyebrow="Gallery"
    title="Inlays set in granite"
    lede="We custom fuse a ¼ inch thick, multi-layered glass ingot. Each piece is cut, shaped, fire-polished and annealed for a perfect fit and finish, leaving an inlay up to 200 times harder than regular glass. It is installed flush with the granite and finished with a cement-based grout, as strong as the sandblasted granite itself."
  >
    <blockquote class="mt-2 max-w-2xl border-l border-gilt/50 pl-5 text-xl italic leading-relaxed text-foreground">
      We sell a method of permanent color, not a particular style. We work hard
      to produce any type of design and strive to keep the essence of the
      original artwork.
    </blockquote>
  </PageHeader>

  <section class="py-12 sm:py-16">
    <div class="shell">
      <div
        id="gallery-grid"
        class="leaded-panel grid grid-cols-2 gap-[5px] rounded-lg p-[5px] sm:grid-cols-3 lg:grid-cols-4"
      >
        {
          images.map((image, index) => (
            <button
              type="button"
              data-gallery-index={index}
              aria-label={`View stained glass inlay ${index + 1} full screen`}
              class="lancet zoom-on-hover aspect-[4/5] cursor-zoom-in bg-card focus-visible:outline-offset-[-3px]"
            >
              <Image
                src={image}
                alt={`Stained glass inlay ${index + 1}`}
                widths={[320, 640]}
                sizes="(min-width: 1024px) 25vw, (min-width: 640px) 33vw, 50vw"
                loading="lazy"
                class="size-full object-cover"
              />
            </button>
          ))
        }
      </div>
      <p class="mt-5 text-center text-sm text-faint">
        Select any photograph to see it full screen.
      </p>
    </div>

    <GalleryLightbox client:idle images={lightboxImages} gridId="gallery-grid" />
  </section>

  <ClosingInvitation />
</Layout>
