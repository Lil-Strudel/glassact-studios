---
import { Image } from "astro:assets";
import ButtonLink from "./button-link.astro";
import ArrowIcon from "./arrow-icon.astro";
import EmblemImg from "../assets/images/s-emblem.png";
import HeroImg from "../assets/images/hero.jpg";

const studioFacts = [
  "Patented process",
  "40 colors that never fade",
  "Usually ships within 2 weeks",
];
---

<section class="crimson-wash relative isolate overflow-hidden border-b border-border">
  <div
    class="shell grid items-center gap-14 pb-16 pt-10 sm:pt-14 lg:grid-cols-[minmax(0,1.05fr)_minmax(0,1fr)] lg:gap-16 lg:pb-24 lg:pt-20"
  >
    <div class="drop-cap-heading">
      <p class="eyebrow reveal text-gilt">
        Custom glass inlays for the memorial industry
      </p>

      <div class="mt-7 flow-root">
        <Image
          src={EmblemImg}
          alt=""
          widths={[240, 400, 600]}
          sizes="(min-width: 1280px) 192px, (min-width: 640px) 160px, 120px"
          loading="eager"
          class="drop-cap emblem-glow illuminate"
        />
        <h1
          class="reveal text-[2.55rem] leading-[1.06] sm:text-6xl xl:text-7xl"
          style="--reveal-delay: 300ms"
        >
          <span class="sr-only">Stained glass, set in stone.</span>
          <span aria-hidden="true">tained glass,<br />set in stone.</span>
        </h1>

        <p
          class="reveal mt-6 max-w-xl text-lg leading-relaxed text-muted-foreground sm:text-xl"
          style="--reveal-delay: 500ms"
        >
          Colored glass, fused, cut and set flush with the granite. Finally, a
          product that answers the need for permanent color on memorials.
        </p>

        <div class="reveal mt-9 flex flex-wrap gap-3" style="--reveal-delay: 650ms">
          <ButtonLink href="/gallery" size="lg" class="w-full sm:w-auto">
            View the gallery
            <ArrowIcon />
          </ButtonLink>
          <ButtonLink href="/catalog" size="lg" variant="secondary" class="w-full sm:w-auto">
            Browse the catalog
          </ButtonLink>
        </div>
      </div>

      <ul
        class="reveal mt-10 flex flex-wrap gap-x-6 gap-y-2 border-t border-border pt-6 text-sm text-muted-foreground"
        style="--reveal-delay: 800ms"
      >
        {
          studioFacts.map((fact) => (
            <li class="flex items-center gap-2.5">
              <span class="lozenge text-gilt" />
              {fact}
            </li>
          ))
        }
      </ul>
    </div>

    <figure class="reveal mx-auto w-full max-w-xl lg:max-w-none" style="--reveal-delay: 450ms">
      <div class="arched-frame aspect-[5/4] bg-came">
        <Image
          src={HeroImg}
          alt="A granite headstone with stained glass inlays of tulips, roses and daisies framing a heart"
          widths={[480, 850]}
          sizes="(min-width: 1024px) 45vw, 100vw"
          loading="eager"
          class="size-full object-cover"
        />
      </div>
      <figcaption class="mt-4 flex items-center justify-center gap-3 text-sm italic text-faint">
        <span class="lozenge text-gilt"></span>
        Glass inlays on a granite headstone
        <span class="lozenge text-gilt"></span>
      </figcaption>
    </figure>
  </div>
</section>
