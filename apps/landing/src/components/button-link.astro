---
import type { HTMLAttributes } from "astro/types";
import {
  buttonVariants,
  type buttonVariantsProps,
} from "@glassact/ui/button-variants";
import { cn } from "@glassact/ui/cn";

export interface Props extends HTMLAttributes<"a">, buttonVariantsProps {}

const {
  variant = "default",
  size = "default",
  class: className,
  ...rest
} = Astro.props;
---

<a class={cn(buttonVariants({ variant, size }), "gap-2", className)} {...rest}>
  <slot />
</a>
