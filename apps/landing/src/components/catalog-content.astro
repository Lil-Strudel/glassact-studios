---
import ButtonLink from "./button-link.astro";
import ArrowIcon from "./arrow-icon.astro";
import CatalogCard from "./catalog-card.astro";
import OrnamentRule from "./ornament-rule.astro";
import { catalogCategories } from "../data/catalog-categories";
---

<section class="py-20 sm:py-28">
  <div class="shell">
    <div class="mx-auto grid max-w-2xl justify-items-center gap-5 text-center">
      <p class="eyebrow text-gilt">Our catalog</p>
      <h2 class="text-4xl sm:text-5xl">Hundreds of finished designs</h2>
      <OrnamentRule class="w-48" />
      <p class="text-lg leading-relaxed text-muted-foreground">
        Every design in our catalog is ready to be manufactured. Many monument
        companies order finished designs from it, or have their favorite
        sandblasting designs changed into colored glass inlays.
      </p>
    </div>

    <div class="mt-14 grid grid-cols-2 gap-x-5 gap-y-10 sm:grid-cols-3 lg:grid-cols-6">
      {catalogCategories.map((category) => <CatalogCard category={category} />)}
    </div>

    <div class="mt-14 flex justify-center">
      <ButtonLink href="/catalog" variant="secondary" size="lg">
        View the full catalog
        <ArrowIcon />
      </ButtonLink>
    </div>
  </div>
</section>
