---
import { Image } from "astro:assets";
import {
  catalogHref,
  type CatalogCategory,
} from "../data/catalog-categories";

interface Props {
  category: CatalogCategory;
}

const { category } = Astro.props;
---

<a href={catalogHref(category)} class="zoom-on-hover group grid gap-3 rounded-sm">
  <div class="came-frame aspect-[4/5] overflow-hidden rounded-lg bg-came transition-shadow duration-200 group-hover:shadow-[0_0_0_1px_hsl(var(--gilt))]">
    <Image
      src={category.image}
      alt={category.imageAlt}
      widths={[240, 480]}
      sizes="(min-width: 1024px) 15vw, (min-width: 640px) 30vw, 45vw"
      class="size-full object-cover"
    />
  </div>
  <div class="grid gap-0.5 text-center">
    <h3 class="text-xl group-hover:text-gilt">{category.title}</h3>
    <p class="text-sm text-faint">{category.description}</p>
  </div>
</a>
