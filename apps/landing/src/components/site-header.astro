---
import LogoImg from "../assets/images/logo-full.svg";
import ButtonLink from "./button-link.astro";
import ArrowIcon from "./arrow-icon.astro";
import { customerPortalUrl, primaryNavigation } from "../data/site";

const currentPath = Astro.url.pathname.replace(/\/$/, "") || "/";
const ariaCurrent = (path: string) => (currentPath === path ? "page" : undefined);

const mobileNavigation = [
  { title: "Home", path: "/" },
  ...primaryNavigation,
  { title: "Contact us", path: "/contact" },
];
---

<header class="sticky top-0 z-40 border-b border-border bg-background/85 backdrop-blur-md">
  <div class="shell flex h-16 items-center justify-between gap-6 lg:h-20">
    <a href="/" class="-m-1 shrink-0 rounded-sm p-1">
      <img
        src={LogoImg.src}
        width={LogoImg.width}
        height={LogoImg.height}
        alt="GlassAct Studios"
        class="h-10 w-auto lg:h-12"
      />
    </a>

    <nav aria-label="Main" class="hidden lg:block">
      <ul class="flex items-center gap-9">
        {
          primaryNavigation.map((item) => (
            <li>
              <a href={item.path} class="nav-link" aria-current={ariaCurrent(item.path)}>
                {item.title}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>

    <div class="hidden items-center gap-2 lg:flex">
      <ButtonLink href={customerPortalUrl} variant="ghost">
        Customer portal
        <ArrowIcon direction="up-right" />
      </ButtonLink>
      <ButtonLink href="/contact">Contact us</ButtonLink>
    </div>

    <button
      type="button"
      class="inline-flex size-10 items-center justify-center rounded-md border border-input text-foreground hover:border-gilt/60 lg:hidden"
      aria-controls="mobile-menu"
      aria-expanded="false"
      aria-label="Open menu"
      data-menu-toggle
    >
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" class="size-5" aria-hidden="true">
        <path d="M4 8h16M4 16h16" data-menu-icon="closed"></path>
        <path d="M6 6l12 12M18 6 6 18" data-menu-icon="open" class="hidden"></path>
      </svg>
    </button>
  </div>

  <nav id="mobile-menu" aria-label="Main" class="hidden border-t border-border bg-background lg:hidden">
    <ul class="shell grid gap-1 py-4">
      {
        mobileNavigation.map((item) => (
          <li>
            <a
              href={item.path}
              aria-current={ariaCurrent(item.path)}
              class="flex items-center justify-between rounded-md px-2 py-3 font-display text-xl text-muted-foreground hover:bg-accent hover:text-foreground aria-[current=page]:text-foreground"
            >
              {item.title}
              {ariaCurrent(item.path) && <span class="lozenge text-crimson-light" />}
            </a>
          </li>
        ))
      }
      <li class="mt-3 border-t border-border pt-4">
        <ButtonLink href={customerPortalUrl} variant="secondary" class="w-full">
          Customer portal
          <ArrowIcon direction="up-right" />
        </ButtonLink>
      </li>
    </ul>
  </nav>
</header>

<script>
  const toggle = document.querySelector<HTMLButtonElement>("[data-menu-toggle]");
  const menu = document.getElementById("mobile-menu");

  function setMenuOpen(isOpen: boolean) {
    if (!toggle || !menu) return;
    toggle.setAttribute("aria-expanded", String(isOpen));
    toggle.setAttribute("aria-label", isOpen ? "Close menu" : "Open menu");
    menu.classList.toggle("hidden", !isOpen);
    toggle
      .querySelector('[data-menu-icon="closed"]')
      ?.classList.toggle("hidden", isOpen);
    toggle
      .querySelector('[data-menu-icon="open"]')
      ?.classList.toggle("hidden", !isOpen);
  }

  toggle?.addEventListener("click", () => {
    setMenuOpen(toggle.getAttribute("aria-expanded") !== "true");
  });

  document.addEventListener("keydown", (event) => {
    if (event.key === "Escape" && toggle?.getAttribute("aria-expanded") === "true") {
      setMenuOpen(false);
      toggle.focus();
    }
  });
</script>
