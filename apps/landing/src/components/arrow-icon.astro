---
interface Props {
  direction?: "right" | "up-right";
  class?: string;
}

const { direction = "right", class: className = "size-4" } = Astro.props;
---

<svg
  xmlns="http://www.w3.org/2000/svg"
  viewBox="0 0 20 20"
  fill="none"
  stroke="currentColor"
  stroke-width="1.5"
  stroke-linecap="round"
  stroke-linejoin="round"
  class={className}
  aria-hidden="true"
>
  {
    direction === "right" ? (
      <path d="M3.5 10h13m-5-5 5 5-5 5" />
    ) : (
      <path d="M6 14 14 6m-6.5 0H14v6.5" />
    )
  }
</svg>
