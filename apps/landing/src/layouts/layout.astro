---
import "@glassact/ui/globals.css";
import "../styles/landing.css";
import SiteHeader from "../components/site-header.astro";
import SiteFooter from "../components/site-footer.astro";

interface Props {
  title?: string;
}

const { title } = Astro.props;
const documentTitle = title ? `${title} | GlassAct Studios` : "Welcome | GlassAct Studios";
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#18120d" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png" />
    <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png" />
    <link rel="icon" type="image/x-icon" href="/favicon.ico" />
    <link rel="manifest" href="/site.webmanifest" />
    <meta
      name="description"
      content="Enhance Memorials Forever with GlassAct Studios' Custom Glass Art Inlays for Granite Monuments. Discover everlasting beauty for memorials with our bespoke glass inlays at GlassAct Studios. Revolutionizing the memorial industry, our inlays provide permanent color on granite, ensuring a timeless tribute that defies fading. While traditional paint or stain lasts a mere 2 to 8 years, our stained glass inlays endure indefinitely. Tested for over a decade on gravestones, these inlays surpass the resilience of carved granite itself, enduring extremes that monuments will never encounter. Choose from our extensive catalog of ready-to-manufacture designs or transform existing sandblasting designs into vivid, enduring glass inlays. Join monument companies nationwide in embracing the permanence and enduring elegance of GlassAct Studios' custom glass art in memorials."
    />
    <meta name="generator" content={Astro.generator} />
    <title>{documentTitle}</title>
    <slot name="head" />
  </head>
  <body>
    <a
      href="#main"
      class="sr-only focus:not-sr-only focus:fixed focus:left-4 focus:top-4 focus:z-50 focus:rounded-md focus:bg-popover focus:px-4 focus:py-2"
    >
      Skip to content
    </a>
    <div class="flex min-h-screen flex-col">
      <SiteHeader />
      <main id="main" class="flex grow flex-col">
        <slot />
      </main>
      <SiteFooter />
    </div>
  </body>
</html>
